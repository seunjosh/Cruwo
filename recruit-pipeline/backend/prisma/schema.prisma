generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Job {
  id              Int           @id @default(autoincrement())
  title           String
  description     String        @db.Text
  requirements    String        @db.Text
  shortlistTarget Int?
  // pause    — stop taking new applications once the target is hit, flag for HR review immediately
  // collect  — keep taking applications and scoring candidates past the target, building a larger
  //            pool HR can pick from; still shows in Review (any job with a shortlisted candidate
  //            already appears there), but never auto-pauses
  onTargetReached String        @default("pause")
  status          String        @default("open")
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  applications    Application[]
}

model Application {
  id                    Int      @id @default(autoincrement())
  candidateName         String
  candidateEmail        String
  jobId                 Int
  job                   Job      @relation(fields: [jobId], references: [id])
  cvFilePath            String
  rawParsedData         String?  @db.Text // JSON from the scoring service
  score                 Float? // match score 0-100
  scoreReason           String?  @db.Text
  status                String   @default("received") // received | screened | shortlisted | rejected | invited
  interviewEmailSubject String?  @db.Text // agent-drafted invite, filled in once HR confirms
  interviewEmailBody    String?  @db.Text
  archived              Boolean  @default(false) // kept for reference, hidden from the active pipeline view
  submittedAt           DateTime @default(now())
}

