{
  "name": "recruit-pipeline",
  "private": true,
  "scripts": {
    "dev": "concurrently -n scoring,backend,frontend -c yellow,cyan,magenta \"npm:dev:scoring\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:scoring": "cd scoring-service && .venv\\Scripts\\python.exe -m uvicorn main:app --port 8000",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "version": "1.0.0",
  "description": "A recruiting platform modeled as a CI/CD pipeline: an application is a commit, automated\r screening is the test suite, shortlisting is a passing build, interviews are staging,\r and an offer is production deploy. Rejected candidates are logged with a reason and\r kept in a talent pool instead of being discarded.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "ansi-regex": "^6.3.0",
    "ansi-styles": "^6.2.3",
    "chalk": "^5.6.2",
    "cliui": "^9.0.1",
    "emoji-regex": "^10.6.0",
    "escalade": "^3.2.0",
    "get-caller-file": "^2.0.5",
    "get-east-asian-width": "^1.6.0",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.9.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "supports-color": "^10.2.2",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^9.0.2",
    "y18n": "^5.0.8",
    "yargs": "^18.0.0",
    "yargs-parser": "^22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
